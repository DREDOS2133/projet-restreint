{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projet-restreint",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projet-restreint-db",
      "database_id": "b38758c4-b4ea-4d2c-919a-acb9ec231924"
    }
  ],
  "vars": {
    "MAX_MEMBERS": "6",
    "SESSION_DAYS": "7"
  }
}
